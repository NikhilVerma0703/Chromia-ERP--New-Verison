# Chromia ERP (standalone) — copy this file to .env and fill it in.
# .env is git-ignored. Never commit a real password.

# PostgreSQL connection string. A local database is all this app needs:
#   postgresql://<user>:<password>@localhost:5432/chromia_erp?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/chromia_erp?schema=public"

# Optional: the name recorded as "who did it" on every save (there is no
# sign-in; every action runs as one local admin user). Default: "Local User".
CHROMIA_ACTING_USER_NAME="Local User"

# Optional: Chromia module log level — debug | info | warn | error.
# Default: debug under `npm run dev`, info under `npm start`.
# LOG_LEVEL=info
