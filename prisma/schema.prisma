// ============================================================================
// Chromia ERP (standalone) — Prisma schema.
//
// Extracted on 2026-10-27 from Pacific ERP's prisma/schema.prisma. Every model
// and enum below is copied from it character for character — fields, @map /
// @@map, indexes and comments — so the table and column names are the ones
// production uses (chromia_*, attendance_*, fg_*, polish_qc, press, jot).
// Comments that point at scripts/NNNN-*.sql or other ERP files describe how
// the table reached Neon; those scripts are kept for reference under
// docs/history/sql/ and are NOT run here. This project changes its schema with
// Prisma migrations (prisma/migrations), not hand-numbered SQL.
//
// Four groups, and why each is here:
//   1. CHROMIA MODULE — the module itself (19 enums, 33 models).
//   2. ATTENDANCE — the register behind Chromia → Attendance (shared with the
//      Robo line in the ERP; Chromia's own copy here).
//   3. FINISHED-GOODS SLICE — what Inventory → Slab Intake reads and writes,
//      and what the Chromia inventory bridge marks (status CHROMIA).
//   4. PRODUCTION-LINE LOOKUPS — Polish QC, Press, Jot: read-only here, used
//      only by Slab Intake to prefill a slab's details. Empty in a fresh local
//      database, which the form already handles ("No production record was
//      found for this number").
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CHROMIA MODULE — Chromia line slab lifecycle (ported from the CHROMIA_MODULE
// standalone app). Intake -> ten processing stages -> QC -> grade ->
// recalibration loop (max 5 attempts) -> dispatch / stock / sample cutting /
// waste, plus the legacy Excel register importer.
//
// Namespacing: every model is Chromia-prefixed and every table/type is
// chromia_-prefixed, matching the Robo precedent — in a 111-model schema a bare
// `Slab` or `Machine` would say nothing about which line owns it. NOTE: the
// pre-existing Chromia1 / ChromiaPar1 models above are legacy Airtable mirrors
// of this same line (tables chromia_1 / chromia_par_1) — untouched, and no name
// here collides with them.
//
// User attribution: the module shipped its own User model and FK'd every action
// to it. Logins here are ERP users (role CHROMIA, gated exactly like Robo — see
// lib/chromia/tier.ts), so every *ById / userId / operatorId / inspectorId
// column below is a plain String? holding an ERP users.id with NO foreign key —
// the Sales precedent. The ChromiaUser table is carried across dormant as the
// module's employee directory; nothing references it and nothing should write
// to it while sign-in is owned by the ERP.
//
// Hand-maintained; NOT touched by gen-schema.py. Conventions kept from the
// module: snake_case tables/columns via @@map/@map, uuid() ids,
// Decimal(18,3) measurements, createdAt/updatedAt everywhere, soft-delete
// deletedAt on business entities, append-only ChromiaSlabEvent.
//
// Neon: scripts/0044-drop-chromia-module.sql drops the previous integration's
// tables, then scripts/0045-chromia-module.sql creates these, then
// scripts/0046-migrate-chromia-branch-users.sql moves any login left on the
// retired CHROMIA department onto the role (NOT db push).
// ============================================================================
enum ChromiaRole {
  ADMIN
  PRODUCTION_MANAGER
  SUPERVISOR
  OPERATOR
  QUALITY_INSPECTOR
  STORE_KEEPER
  VIEWER

  @@map("chromia_role")
}

enum ChromiaUserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("chromia_user_status")
}

/// The ten stages of the Chromia process, in order.
enum ChromiaProcessStage {
  INCOMING
  INCOMING_DETAILS
  BASE_PRIMER
  PRINTING
  MOULDING
  COOLING
  POLISHING
  UV_POLISHING
  QUALITY_CHECK
  GRADE_DECISION

  @@map("chromia_process_stage")
}

enum ChromiaStageStatus {
  PENDING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  SKIPPED

  @@map("chromia_stage_status")
}

/// Lifecycle state of a physical slab (renamed from the module's SlabStatus —
/// the ERP's SlabStatus enum belongs to finished-goods inventory).
enum ChromiaSlabStatus {
  RECEIVED
  IN_PROCESS
  UNDER_INSPECTION
  GRADED
  OUT_FOR_RECALIBRATION
  RECEIVED_FROM_RECALIBRATION
  IN_STOCK
  SAMPLE_CUT
  DISPATCHED
  WASTE
  ON_HOLD
  /// Sent from the Stockyard as Approved (27 Oct 2026, migration 0003). Off
  /// the rack, still Chromia's; its own section is to come.
  APPROVED

  @@map("chromia_slab_status")
}

/// Where a stocked slab went when it left the Stockyard — the Stock Outcome
/// the yard chose (27 Oct 2026, migration 0003).
enum ChromiaStockOutcome {
  DISPATCH
  APPROVED
  SAMPLE_CUTTING

  @@map("chromia_stock_outcome")
}

enum ChromiaCycleStatus {
  ACTIVE
  COMPLETED
  ABORTED

  @@map("chromia_cycle_status")
}

enum ChromiaSlabGrade {
  A
  B
  C

  @@map("chromia_slab_grade")
}

enum ChromiaDisposition {
  DISPATCH
  STOCK
  SAMPLE_CUTTING
  RECALIBRATION
  WASTE

  @@map("chromia_disposition")
}

enum ChromiaPrintResult {
  FULLY_PRINTED
  HALF_PRINT
  BYPASSED

  @@map("chromia_print_result")
}

enum ChromiaQcVerdict {
  PASS
  CONDITIONAL_PASS
  FAIL

  @@map("chromia_qc_verdict")
}

enum ChromiaQcCheckResult {
  PASS
  FAIL
  NOT_APPLICABLE

  @@map("chromia_qc_check_result")
}

enum ChromiaDefectSeverity {
  MINOR
  MAJOR
  CRITICAL

  @@map("chromia_defect_severity")
}

enum ChromiaRecalibrationStatus {
  PENDING_DISPATCH
  SENT
  AT_FACILITY
  RECEIVED
  RESTARTED
  CANCELLED

  @@map("chromia_recalibration_status")
}

enum ChromiaLocationType {
  YARD
  RACK
  MACHINE_BAY
  COOLING_ZONE
  QC_AREA
  DISPATCH_BAY
  STOCK_RACK
  SAMPLE_AREA
  EXTERNAL_FACILITY
  WASTE_AREA

  @@map("chromia_location_type")
}

enum ChromiaMachineType {
  PRIMER_LINE
  PRINTER
  MOULDING_PRESS
  COOLING_RACK
  POLISHING_LINE
  UV_LINE
  OTHER

  @@map("chromia_machine_type")
}

enum ChromiaMovementReason {
  INTAKE
  STAGE_TRANSFER
  QC_TRANSFER
  RECALIBRATION_OUT
  RECALIBRATION_IN
  DISPATCH
  STOCK_PUTAWAY
  SAMPLE_CUTTING
  WASTE_DISPOSAL
  CORRECTION

  @@map("chromia_movement_reason")
}

/// Append-only slab event categories. See the ChromiaSlabEvent model.
enum ChromiaSlabEventType {
  SLAB_CREATED
  STAGE_STARTED
  STAGE_COMPLETED
  STAGE_HELD
  STAGE_RESUMED
  CYCLE_STARTED
  CYCLE_COMPLETED
  QC_RECORDED
  GRADE_ASSIGNED
  RECALIBRATION_SENT
  RECALIBRATION_RECEIVED
  RECALIBRATION_RESTARTED
  LOCATION_CHANGED
  STATUS_CHANGED
  DISPATCHED
  STOCKED
  SAMPLE_CUT
  DECLARED_WASTE
  CORRECTION

  @@map("chromia_slab_event_type")
}

enum ChromiaImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED

  @@map("chromia_import_status")
}

enum ChromiaAuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT

  @@map("chromia_audit_action")
}

/// DORMANT — carried across from the standalone module, where it was the
/// login table. In the ERP, Chromia staff sign in as `users` rows (branch
/// CHROMIA) and every attribution column stores users.id as a plain string,
/// so nothing points here. Kept (not dropped) so the employee-code / shift
/// directory concept survives if the line wants it later without a schema
/// change. Do not write to it while sign-in is owned by the ERP.
model ChromiaUser {
  id           String            @id @default(uuid())
  employeeCode String            @unique @map("employee_code")
  email        String            @unique
  name         String
  passwordHash String?           @map("password_hash")
  role         ChromiaRole       @default(OPERATOR)
  status       ChromiaUserStatus @default(ACTIVE)
  phone        String?
  shift        String?
  lastLoginAt  DateTime?         @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([role, status])
  @@index([deletedAt])
  @@map("chromia_user")
}

model ChromiaAuditLog {
  id         String             @id @default(uuid())
  entity     String
  entityId   String             @map("entity_id")
  action     ChromiaAuditAction
  userId     String?            @map("user_id") // -> users.id (no hard FK)
  changes    Json?
  ipAddress  String?            @map("ip_address")
  userAgent  String?            @map("user_agent")
  occurredAt DateTime           @default(now()) @map("occurred_at")

  @@index([entity, entityId])
  @@index([userId])
  @@index([occurredAt])
  @@map("chromia_audit_log")
}

/// Base slab material — "Coastal Pearl", "Bianco Cristallo", "Maple Gaze", ...
model ChromiaBaseMaterial {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  description          String?
  defaultThicknessMm   Decimal? @map("default_thickness_mm") @db.Decimal(18, 3)
  minUsableThicknessMm Decimal? @map("min_usable_thickness_mm") @db.Decimal(18, 3)
  isActive             Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  batches ChromiaBatch[]
  slabs   ChromiaSlab[]

  @@index([isActive])
  @@map("chromia_base_material")
}

/// Digital print artwork — "Cristallo OG", "Lighter Thaj 3", "AlmondMist1", ...
model ChromiaDesign {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  fileName String  @map("file_name")
  version  String?
  notes    String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  plannedForSlabs ChromiaSlab[]           @relation("ChromiaPlannedDesign")
  processCycles   ChromiaProcessCycle[]
  printingDetails ChromiaPrintingDetail[]

  @@index([isActive])
  @@index([fileName])
  @@map("chromia_design")
}

model ChromiaMachine {
  id       String               @id @default(uuid())
  code     String               @unique
  name     String
  type     ChromiaMachineType
  stage    ChromiaProcessStage?
  isActive Boolean              @default(true) @map("is_active")

  locationId String?          @map("location_id")
  location   ChromiaLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  stageRecords ChromiaStageRecord[]

  @@index([type, isActive])
  @@index([stage])
  @@map("chromia_machine")
}

model ChromiaLocation {
  id       String              @id @default(uuid())
  code     String              @unique
  name     String
  type     ChromiaLocationType
  capacity Int?
  isActive Boolean             @default(true) @map("is_active")

  parentId String?           @map("parent_id")
  parent   ChromiaLocation?  @relation("ChromiaLocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ChromiaLocation[] @relation("ChromiaLocationHierarchy")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  machines       ChromiaMachine[]
  slabsHere      ChromiaSlab[]          @relation("ChromiaSlabCurrentLocation")
  stageRecords   ChromiaStageRecord[]
  movementsFrom  ChromiaSlabMovement[]  @relation("ChromiaMovementFrom")
  movementsTo    ChromiaSlabMovement[]  @relation("ChromiaMovementTo")
  slabEvents     ChromiaSlabEvent[]
  stockEntries   ChromiaStockEntry[]
  gradeDecisions ChromiaGradeDecision[] @relation("ChromiaGradeTargetLocation")

  @@index([type, isActive])
  @@map("chromia_location")
}

/// Configuration for each of the ten stages — sequence and expected duration.
model ChromiaStageDefinition {
  id                      String              @id @default(uuid())
  stage                   ChromiaProcessStage @unique
  sequence                Int                 @unique
  name                    String
  description             String?
  expectedDurationMinutes Int                 @map("expected_duration_minutes")
  warnAfterMinutes        Int?                @map("warn_after_minutes")
  requiresMachine         Boolean             @default(false) @map("requires_machine")
  requiresOperator        Boolean             @default(true) @map("requires_operator")
  isActive                Boolean             @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chromia_stage_definition")
}

model ChromiaDefectType {
  id              String                @id @default(uuid())
  code            String                @unique
  name            String
  originStage     ChromiaProcessStage?  @map("origin_stage")
  defaultSeverity ChromiaDefectSeverity @default(MAJOR) @map("default_severity")
  description     String?
  isActive        Boolean               @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  qcDefects    ChromiaQcDefect[]
  wasteRecords ChromiaWasteRecord[]

  @@index([originStage, isActive])
  @@map("chromia_defect_type")
}

/// Structured recalibration reasons — "Half Print", "Red Colour Deviation", ...
model ChromiaRecalibrationReason {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  originStage ChromiaProcessStage? @map("origin_stage")
  description String?
  isActive    Boolean              @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  recalibrationCycles ChromiaRecalibrationCycle[]

  @@index([isActive])
  @@map("chromia_recalibration_reason")
}

model ChromiaSupplier {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  contactPerson String? @map("contact_person")
  phone         String?
  email         String?
  address       String?
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  batches ChromiaBatch[]

  @@map("chromia_supplier")
}

model ChromiaCustomer {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  contactPerson String? @map("contact_person")
  phone         String?
  email         String?
  address       String?
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  dispatches ChromiaDispatch[]

  @@map("chromia_customer")
}

model ChromiaBatch {
  id           String   @id @default(uuid())
  batchNo      String   @unique @map("batch_no")
  receivedDate DateTime @map("received_date")
  totalSlabs   Int      @default(0) @map("total_slabs")
  notes        String?

  baseMaterialId String              @map("base_material_id")
  baseMaterial   ChromiaBaseMaterial @relation(fields: [baseMaterialId], references: [id])

  supplierId String?          @map("supplier_id")
  supplier   ChromiaSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdById String?   @map("created_by_id") // -> users.id (no hard FK)
  updatedById String?   @map("updated_by_id") // -> users.id (no hard FK)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  slabs ChromiaSlab[]

  @@index([receivedDate])
  @@index([baseMaterialId])
  @@map("chromia_batch")
}

/// One physical slab. Its identity is permanent for the slab's entire life,
/// across every recalibration cycle.
model ChromiaSlab {
  id     String @id @default(uuid())
  slabNo String @unique @map("slab_no")

  batchId String       @map("batch_id")
  batch   ChromiaBatch @relation(fields: [batchId], references: [id])

  baseMaterialId String              @map("base_material_id")
  baseMaterial   ChromiaBaseMaterial @relation(fields: [baseMaterialId], references: [id])

  plannedDesignId String?        @map("planned_design_id")
  plannedDesign   ChromiaDesign? @relation("ChromiaPlannedDesign", fields: [plannedDesignId], references: [id], onDelete: SetNull)

  // Physical attributes
  originalThicknessMm Decimal? @map("original_thickness_mm") @db.Decimal(18, 3)
  currentThicknessMm  Decimal? @map("current_thickness_mm") @db.Decimal(18, 3)
  lengthMm            Decimal? @map("length_mm") @db.Decimal(18, 3)
  widthMm             Decimal? @map("width_mm") @db.Decimal(18, 3)

  // Live position — denormalised for fast dashboard reads. Always written in
  // the same transaction as the ChromiaSlabEvent that caused the change.
  status             ChromiaSlabStatus    @default(RECEIVED)
  currentStage       ChromiaProcessStage? @map("current_stage")
  currentCycleNumber Int                  @default(1) @map("current_cycle_number")

  currentLocationId String?          @map("current_location_id")
  currentLocation   ChromiaLocation? @relation("ChromiaSlabCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)

  // Outcome
  currentGrade       ChromiaSlabGrade?   @map("current_grade")
  currentDisposition ChromiaDisposition? @map("current_disposition")

  // Recalibration counters — the five-attempt ceiling is checked against these.
  recalibrationCount Int     @default(0) @map("recalibration_count")
  isRecalibrationOut Boolean @default(false) @map("is_recalibration_out")

  receivedDate       DateTime @map("received_date")
  /// S.No. — the slab's number within its own production date, as the paper
  /// register numbers it. NUMBERED BY THE DATABASE, never by the app: the
  /// trigger chromia_slab_entry_serial (migration 0002) gives every new row,
  /// and every row whose production date changes, the next number for that
  /// date, under a per-date lock, so two saves at once cannot share one. The
  /// unique index below refuses a duplicate whatever writes it. A deleted slab
  /// leaves a gap; the slabs after it keep their numbers.
  entrySerialNo      Int?     @map("entry_serial_no")
  conditionOnArrival String?  @map("condition_on_arrival")
  remarks            String?

  // Legacy Excel import — null for records created inside the ERP.
  legacySourceFile String?             @map("legacy_source_file")
  legacySheetName  String?             @map("legacy_sheet_name")
  legacySourceRow  Int?                @map("legacy_source_row")
  legacyRemark     String?             @map("legacy_remark")
  importBatchId    String?             @map("import_batch_id")
  importBatch      ChromiaImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  createdById String?   @map("created_by_id") // -> users.id (no hard FK)
  updatedById String?   @map("updated_by_id") // -> users.id (no hard FK)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  cycles         ChromiaProcessCycle[]
  stageRecords   ChromiaStageRecord[]
  events         ChromiaSlabEvent[]
  movements      ChromiaSlabMovement[]
  qcRecords      ChromiaQcRecord[]
  gradeDecisions ChromiaGradeDecision[]
  recalibrations ChromiaRecalibrationCycle[]
  dispatches     ChromiaDispatch[]
  stockEntries   ChromiaStockEntry[]
  sampleCuttings ChromiaSampleCutting[]
  wasteRecord    ChromiaWasteRecord?

  @@index([status])
  @@index([status, currentStage])
  @@index([currentStage])
  @@index([batchId])
  @@index([currentLocationId])
  @@index([isRecalibrationOut])
  @@unique([receivedDate, entrySerialNo])
  @@index([receivedDate])
  @@index([deletedAt])
  @@map("chromia_slab")
}

/// One complete pass of a slab through the ten stages.
/// Cycle 1 is the original pass; cycle n+1 follows the n-th recalibration.
model ChromiaProcessCycle {
  id          String             @id @default(uuid())
  cycleNumber Int                @map("cycle_number")
  status      ChromiaCycleStatus @default(ACTIVE)
  startedAt   DateTime           @default(now()) @map("started_at")
  completedAt DateTime?          @map("completed_at")

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  designId String?        @map("design_id")
  design   ChromiaDesign? @relation(fields: [designId], references: [id], onDelete: SetNull)

  /// Processing window. The six production stages (Base Primer, Printing,
  /// Moulding, Cooling, Polishing, UV Polishing) are NOT timed individually —
  /// the slab is stamped in when it enters processing and out when all of
  /// them are finished.
  inTime            DateTime? @map("in_time")
  outTime           DateTime? @map("out_time")
  processingMinutes Int?      @map("processing_minutes")

  /// The date the slab came out fully printed — the register's "fully printed
  /// date" column. Recorded per cycle, so a recalibrated slab that is printed
  /// again gets its own date on cycle 2.
  fullyPrintedDate DateTime? @map("fully_printed_date") @db.Date

  printResult ChromiaPrintResult? @map("print_result")
  finalGrade  ChromiaSlabGrade?   @map("final_grade")
  disposition ChromiaDisposition?
  notes       String?

  createdById String?  @map("created_by_id") // -> users.id (no hard FK)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stageRecords  ChromiaStageRecord[]
  events        ChromiaSlabEvent[]
  qcRecord      ChromiaQcRecord?
  gradeDecision ChromiaGradeDecision?
  failedInto    ChromiaRecalibrationCycle? @relation("ChromiaFailedCycle")
  restartedFrom ChromiaRecalibrationCycle? @relation("ChromiaRestartedCycle")

  @@unique([slabId, cycleNumber])
  @@index([status])
  @@index([slabId])
  @@index([outTime])
  @@map("chromia_process_cycle")
}

/// Execution record for one stage within one cycle.
/// Start and end are captured separately, so true stage duration is known.
model ChromiaStageRecord {
  id       String              @id @default(uuid())
  stage    ChromiaProcessStage
  sequence Int
  status   ChromiaStageStatus  @default(PENDING)

  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationMinutes Int?      @map("duration_minutes")
  holdMinutes     Int?      @map("hold_minutes")
  isOverdue       Boolean   @default(false) @map("is_overdue")

  cycleId String              @map("cycle_id")
  cycle   ChromiaProcessCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  operatorId String? @map("operator_id") // -> users.id (no hard FK)

  machineId String?         @map("machine_id")
  machine   ChromiaMachine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  locationId String?          @map("location_id")
  location   ChromiaLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incomingDetail    ChromiaIncomingDetail?
  primerDetail      ChromiaPrimerDetail?
  printingDetail    ChromiaPrintingDetail?
  mouldingDetail    ChromiaMouldingDetail?
  coolingDetail     ChromiaCoolingDetail?
  polishingDetail   ChromiaPolishingDetail?
  uvPolishingDetail ChromiaUvPolishingDetail?

  @@unique([cycleId, stage])
  @@index([slabId, stage])
  @@index([stage, status])
  @@index([status, startedAt])
  @@index([operatorId])
  @@map("chromia_stage_record")
}

/// Append-only history. Never updated, never deleted — corrections are
/// recorded as new events of type CORRECTION. (Renamed from the module's
/// SlabEvent — the ERP's SlabEvent is the production-line slab event.)
model ChromiaSlabEvent {
  id        String               @id @default(uuid())
  eventType ChromiaSlabEventType @map("event_type")

  slabId String      @map("slab_id")
  slab   ChromiaSlab @relation(fields: [slabId], references: [id], onDelete: Cascade)

  cycleId String?              @map("cycle_id")
