// ==========================================
// ATTENDANCE MODULE — ONE register, shared by the Robo line and the Chromia line.
//
// The same operators work both lines, some days one, some days both, so there
// is exactly one set of tables and both modules read and write it. That is the
// whole of the "keep the two ERPs in step" requirement: there is nothing to
// synchronise because there is only ever one copy. The unique key on
// (date, operator) is what makes a duplicate impossible rather than unlikely —
// whichever ERP the day is entered from, it is the same row.
//
// Namespaced attendance_* and owned by neither module, like consumable_* and
// fg_*. Times are "HH:MM" and dates yyyy-mm-dd, the convention the shop-floor
// modules already use, so nothing here needs a timezone.
//
// In production by scripts/0123-robo-shift-attendance.sql (with
// RoboProductionRecord.productionShift); tests/roboShiftAttendance0123.test.ts
// holds the script and this block to one another.
// ==========================================
/// The plant's operators, as the attendance register knows them. Deliberately
/// NOT RoboOperator: that one is Robo-named, dormant (seeded once, read
/// nowhere, no UI) and would read oddly as the source of Chromia's roster.
model AttendanceOperator {
  id        String   @id @default(cuid())
  /// Unique, so the same person cannot be added twice from two screens.
  name      String   @unique
  /// Kept out of the register without losing their history. A name that has
  /// ever been used cannot be deleted (the foreign keys below restrict it);
  /// it is deactivated instead.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Where the name sits in the register, and the ONLY thing that decides it.
  /// The roster is the owner's list in the owner's order — the order the line
  /// is called in, which is not alphabetical and must not be re-sorted into it.
  /// A new operator is appended (max + 1), so adding one never moves another.
  ///
  /// LAST in the model because it is last in the table: it was added after the
  /// three tables were made, by scripts/0139-attendance-roster-order.sql, and
  /// ADD COLUMN appends. tests/roboShiftAttendance0123.test.ts holds the two
  /// orders to one another.
  sortOrder Int      @default(0)

  days   AttendanceDay[]
  leaves AttendanceLeave[]

  @@map("attendance_operator")
}

/// One operator's attendance for one date — ONE row however many lines they
/// worked. An operator on both lines that day has one In and one Out, not two
/// of each: they came to work once.
model AttendanceDay {
  id         String             @id @default(cuid())
  /// yyyy-mm-dd.
  date       String
  operatorId String
  operator   AttendanceOperator @relation(fields: [operatorId], references: [id])
  /// The lines worked, comma-joined in a fixed order: "ROBO", "CHROMIA" or
  /// "ROBO,CHROMIA" — see parseLines / joinLines in lib/attendance/attendance.ts,
  /// the only things that read or write this. Empty when nobody has said yet.
  lines      String             @default("")
  inTime     String?
  outTime    String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([date, operatorId])
  @@index([date])
  @@map("attendance_day")
}

/// A leave request, typed by the operator. Free of the attendance row on
/// purpose: leave is asked for in advance and may never become a day worked.
model AttendanceLeave {
  id         String             @id @default(cuid())
  /// yyyy-mm-dd — the date the leave is for.
  date       String
  operatorId String
  operator   AttendanceOperator @relation(fields: [operatorId], references: [id])
  /// The hours away, "HH:MM" each. Both empty reads as the whole day.
  fromTime   String?
  toTime     String?
  reason     String             @default("")
  remarks    String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  /// Whether the operator said they would be away: "INFORMED" or "UNINFORMED".
  /// The code, never the label — the words on screen can be reworded without
  /// rewriting history. "" only for a row written before the field existed;
  /// every new record must carry one, which the API enforces.
  ///
  /// LAST in the model because it is last in the table: added after 0123 made
  /// it, by scripts/0140-attendance-leave-type.sql, and ADD COLUMN appends.
  leaveType  String             @default("")

  @@index([date])
  @@map("attendance_leave")
}

// ============================================================================
// 3. FINISHED-GOODS SLICE (fg_*, entry_photo, commercial_design_code)
//
// Pacific ERP's finished-goods inventory tables that Slab Intake and the
// Chromia inventory bridge (src/lib/chromia/inventory-bridge.ts) touch, and
// nothing more. The rest of finished goods — the inventory screens, sales
// holds, packing lists, dispatch — stays in the main ERP.
// ============================================================================

/// Optional photo attached to a shop-floor entry record — bytea in Postgres
/// because Vercel has no disk (like FinanceBillImage). Saved best-effort from
/// createRow/saveRow; (model, record_id) points at the owning row. See src/lib/entryPhoto.ts.
model EntryPhoto {
  id       String   @id
  model    String
  recordId String   @map("record_id")
  filename String
  mime     String
  data     Bytes
  takenBy  String?  @map("taken_by")
  at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([model, recordId], map: "entry_photo_record")
  @@map("entry_photo")
}

enum SlabStatus {
  AVAILABLE
  RESERVED
  PACKED
  DISPATCHED
  RETURNED
  CTS // cut to size - committed to cutting, still physically in stock
  CHROMIA // taken into the Chromia printing module - applied by its intake, not by hand
}

enum SlabSource {
  QC_AUTOLINK
  BULK_UPLOAD
  MANUAL_ENTRY // typed in on /slab-intake — a slab finished goods was missing (already-made stock, Chromia printed slabs)
}

model FinishedSlab {
  id         String @id @default(cuid())
  slabNumber Float  @unique @map("slab_number")

  // ---- QC-owned: overwritten each time the slab passes QC ----
  design         String?   @map("design")
  grade          String?   @map("grade") // A / A2 / B / C / CTS / Printing (exclusive)
  // WHAT BECAME OF THE SLAB, beside how good the stone is. FULL_SLAB / CTS /
  // SAMPLE, mirrored from polish_qc.slab_mark (scripts/0057) by scripts/0070.
  //
  // THE DISPATCH RULE READS THIS. lib/inventory/grading.ts refuses to dispatch a
  // slab whose MARK says cut — `grade` above kept that job alone until 2026-09-03,
  // which is why fabrication had to overwrite the polishing line's A/B/C verdict
  // with 'CTS' to stop an already-cut slab leaving whole. Both signals are read
  // now (slabBlocksDispatch ORs them), so the grade write can finally go.
  //
  // DECLARED HERE BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS — that is
  // exactly how alt_role and alt_branch were lost. Same note as on PolishQc.
  slabMark       String    @default("FULL_SLAB") @map("slab_mark")
  slabThickness  String?   @map("slab_thickness")
  qualityIssue   String[]  @default([]) @map("quality_issue") // mirrored from PolishQc each QC pass
  polishType     String?   @map("polish_type") // Polish / Suede / Honed / Leathered
  rwStatus       String?   @map("rw_status")
  repolishStatus String?   @map("repolish_status")
  batchNumber    String?   @map("batch_number")
  batchKey       String?   @map("batch_key")
  barcode        String?   @map("barcode")
  qcInspector    String?   @map("qc_inspector")
  lastQcAt       DateTime? @map("last_qc_at")
  lengthIn       Float?    @default(137) @map("length_in") // default full slab 137" x 79"
  widthIn        Float?    @default(79) @map("width_in") // sqft = L*W/144, sqm = sqft*0.092903 (derived)

  // ---- Location: Bay set at QC, Frame set by Dispatch (cleared on re-QC) ----
  bayNumber   String? @map("bay_number")
  frameNumber String? @map("frame_number")

  // ---- Inventory-owned: never overwritten by QC ----
  status               SlabStatus @default(AVAILABLE) @map("status")
  reservedForPi        String?    @map("reserved_for_pi")
  customer             String?    @map("customer")
  reservedAt           DateTime?  @map("reserved_at")
  reservationExpiresAt DateTime?  @map("reservation_expires_at")
  notes                String?    @map("notes")

  // ---- Provenance / stock-age ----
  source      SlabSource @default(QC_AUTOLINK) @map("source")
  firstSeenAt DateTime   @default(now()) @map("first_seen_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  events SlabEvent[]

  @@index([batchKey])
  @@index([status])
  @@index([grade])
  @@index([design])
  @@map("fg_finished_slab")
}

model DesignAlias {
  id        String   @id @default(cuid())
  variant   String   @unique @map("variant")
  canonical String   @map("canonical")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([canonical])
  @@map("fg_design_alias")
}

/// The design-name list (scripts/0115): the only names a form may give a
/// design. Managers add and retire names on /designs; nothing is deleted.
/// Rules in src/lib/designList/rules.ts.
model DesignName {
  id         String   @id @default(cuid())
  name       String
  /// The name in capitals, letters and digits only (foldName) — unique, so
  /// "Simply white" cannot be added beside "Simply White".
  nameKey    String   @unique @map("name_key")
  isTrial    Boolean  @default(false) @map("is_trial")
  /// Quartz | Cristobalite | Glass | Mix (optional).
  fillerType String?  @map("filler_type")
  gritType   String?  @map("grit_type")
  fillerSize String?  @map("filler_size")
  gritSize   String?  @map("grit_size")
  notes      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("design_name")
}

model SlabEvent {
  id         String       @id @default(cuid())
  slabNumber Float        @map("slab_number")
  slab       FinishedSlab @relation(fields: [slabNumber], references: [slabNumber])
  kind       String       @map("kind") // created | qc_update | location | status | reserve | pack | dispatch | return | flagged_non_integer
  field      String?      @map("field")
  oldValue   String?      @map("old_value")
  newValue   String?      @map("new_value")
  changedBy  String?      @map("changed_by")
  source     String?      @map("source")
  at         DateTime     @default(now()) @map("at")

  @@index([slabNumber])
  @@index([at])
  @@map("fg_slab_event")
}

/// A batch ticked "approved for Sales" on the inventory approval screen:
/// a row here puts the batch in the register + Sales view; deleting it sends
/// the batch back to PENDING. Upserted raw with ON CONFLICT (design, batch).
model SalesApprovedBatch {
  design     String   @map("design")
  batch      String   @default("") @map("batch")
  approvedBy String?  @map("approved_by")
  at         DateTime @default(now()) @map("at") @db.Timestamptz(6)

  @@id([design, batch])
  @@map("fg_sales_approved_batch")
}

/// A design hidden from the Sales inventory view (design-level master switch,
/// incl. __TRIALS__). batch is '' rather than NULL so the composite PK can
/// hold — Postgres treats NULLs as distinct.
model SalesHiddenDesign {
  design   String   @map("design")
  hiddenBy String?  @map("hidden_by")
  at       DateTime @default(now()) @map("at") @db.Timestamptz(6)
  batch    String   @default("") @map("batch")

  @@id([design, batch])
  @@map("fg_sales_hidden_design")
}

/// One row per canonical design: the owner's item code (answer 20) and the
/// shade the planning queue sequences by (answer 13). scripts/0079.
model CommercialDesignCode {
  design         String   @id
  code           String?  @unique
  /// LIGHT / MEDIUM / DARK. A first guess from the name until confirmed.
  shade          String?
  shadeConfirmed Boolean  @default(false) @map("shade_confirmed")
  /// Answer 15: the owner reads L*a*b* off the sample and may overrule the hex
  /// by hand. L* is what decides an abrupt changeover (answer 14).
  colourName     String?  @map("colour_name")
  hex            String?
  labL           Decimal? @map("lab_l") @db.Decimal(6, 2)
  labA           Decimal? @map("lab_a") @db.Decimal(6, 2)
  labB           Decimal? @map("lab_b") @db.Decimal(6, 2)
  /// Other names this colour goes by — what customers call it on their POs and
  /// want on their papers (owner, 16 Oct 2026: HONEYDEW is HDWT10314A). One
  /// name belongs to one design only; the route refuses a clash (design-rules
  /// alternateNamesRefusal). scripts/0122.
  alternateNames String[] @default([]) @map("alternate_names")
  notes          String?
  updatedById    String?  @map("updated_by_id") // -> users.id (no hard FK)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("commercial_design_code")
}

// ============================================================================
// 4. PRODUCTION-LINE LOOKUPS (polish_qc, press, jot) — read-only here
//
// Airtable-mirrored production tables from Pacific ERP. Slab Intake looks a
// slab number up in them to prefill a new finished-goods row; nothing in this
// project writes to them.
// ============================================================================

model PolishQc {
  id                  String    @id @default(cuid())
  airtableId          String    @unique
  slabNumber          Float?    @map("slab_number")
  batchNumber         String?   @map("batch_number")
  design              String?   @map("design")
  createdTime         DateTime? @map("created_time")
  lastModifiedBy      Json?     @map("last_modified_by")
  rwStatus            String?   @map("rw_status")
  repolishStatus      String?   @map("repolish_status")
  inspector           String?   @map("inspector")
  goingToDispatch     String?   @map("going_to_dispatch")
  rwDoneBy            String?   @map("rw_done_by")
  slabThickness       String?   @map("slab_thickness")
  qualityIssue        String[]  @default([]) @map("quality_issue")
  qualityGrade        String?   @map("quality_grade")
  // TWO FACTS, NOT ONE. quality_grade above holds the polishing line's verdict
  // (A/A2/B/C) — but markQcSlabCts overwrites it with 'CTS' when fabrication
  // takes the slab, which destroys that verdict and answers a different
  // question in its place. So:
  //   quality_grade_before_cts  the verdict as it was, kept by scripts/0056
  //   slab_mark                 FULL_SLAB / CTS / SAMPLE, by scripts/0057
  // DECLARED HERE BECAUSE `prisma db push` DROPS UNDECLARED COLUMNS — that is
  // exactly how alt_role and alt_branch were lost. Do not remove either line.
  qualityGradeBeforeCts String?  @map("quality_grade_before_cts")
  slabMark            String    @default("FULL_SLAB") @map("slab_mark")
  topPolish           Boolean   @default(false) @map("top_polish")
  bottomPolish        Boolean   @default(false) @map("bottom_polish")
  lamination          Boolean   @default(false) @map("lamination")
  sku                 String?   @map("sku")
  bay                 String?   @map("bay")
  polishType          String?   @map("polish_type")
  dispatchStatus      String?   @map("dispatch_status")
  barcode             Json?     @map("barcode")
  barcodeApiLink      Json?     @map("barcode_api_link")
  linkIds             String[]  @default([]) @map("link")
  barcodeFromLink     Json?     @map("barcode_from_link")
  batchNumberFromLink Json?     @map("batch_number_from_link")
  mainBodyL           Float?    @map("main_body_l")
  mainBodyA           Float?    @map("main_body_a")
  mainBodyB           Float?    @map("main_body_b")
  bBodyL              Float?    @map("b_body_l")
  bBodyA              Float?    @map("b_body_a")
  bBodyB              Float?    @map("b_body_b")
  f3rdBodyL           Float?    @map("f_3rd_body_l")
  f3rdBodyA           Float?    @map("f_3rd_body_a")
  f3rdBodyB           Float?    @map("f_3rd_body_b")
  image               Json?     @map("image")
  shed4To5            Boolean   @default(false) @map("shed_4_to_5")
  sentToChromia       Boolean   @default(false) @map("sent_to_chromia")
  remarks             String?   @map("remarks")
  formula             Json?     @map("formula")
  printed             Boolean   @default(false) @map("printed")
  chromia1Ids         String[]  @default([]) @map("chromia_1")
  slabSummaryIds      String[]  @default([]) @map("slab_summary")
  slabSegregationIds  String[]  @default([]) @map("slab_segregation")
  chromia1Copy        String?   @map("chromia_1_copy")
  importedAt          DateTime  @default(now()) @map("imported_at")
  syncedAt            DateTime  @updatedAt @map("synced_at")
  batchKey            String?   @map("batch_key")
  enteredById         String?   @map("entered_by_user_id") // who created this row in the ERP (operator self-edit)

  @@index([batchKey])
  // 0038 hot-path (2026-08-14): slab_number was the app's single worst predicate — 11 ms
  // seq scan over 3,624 buffers per shift instance in shiftScore (~90/scoreboard load),
  // plus the dup guard on every QC save. imported_at serves /live findFirst + /tables sort.
  @@index([slabNumber])
  @@index([importedAt])
  // 0051 hot-path (2026-08-23): the "created_time in range OR (created_time IS NULL AND
  // imported_at in range)" window (misShift polish throughput, run 2-3x per /mis load and again
  // every 45 s per open tab) was a 105 ms seq scan over 3,624 buffers because only imported_at
  // was indexed — Postgres cannot BitmapOr the two arms until created_time has one too.
  @@index([createdTime])
  @@map("polish_qc")
}

model Press {
  id                                             String    @id @default(cuid())
  airtableId                                     String    @unique
  batch                                          String?   @map("batch")
  operator                                       String?   @map("operator")
  designName                                     String?   @map("design_name")
  slabNumber                                     Float?    @map("slab_number")
  createdTime                                    DateTime? @map("created_time")
  date                                           DateTime? @map("date")
  inTime                                         Float?    @map("in_time")
  slabWeight                                     Float?    @map("slab_weight")
  temperatureInDegreeCelsiusNoteOnlyAt1500And300 Float?    @map("temperature_in_degree_celsius_note_only_at_15_00_and_3_00")
  noOfVacuumPumps                                Float?    @map("no_of_vacuum_pumps")
  noOfStages                                     Float?    @map("no_of_stages")
  vacuumDelayInSeconds                           Float?    @map("vacuum_delay_in_seconds")
  loweChamberVacuumInMbar                        Float?    @map("lowe_chamber_vacuum_in_mbar")
  pinholeCycle                                   String?   @map("pinhole_cycle")
  pinholeCyclePhase                              String?   @map("pinhole_cycle_phase")
  pinholeCycleDelay                              Float?    @map("pinhole_cycle_delay")
  phase1Rev                                      Float?    @map("phase_1_rev")
  phase2Rev                                      Float?    @map("phase_2_rev")
  phase3Rev                                      Float?    @map("phase_3_rev")
  phase4Rev                                      Float?    @map("phase_4_rev")
  phase5Rev                                      Float?    @map("phase_5_rev")
  phase1PressingTime                             Float?    @map("phase_1_pressing_time")
  phase2PressingTime                             Float?    @map("phase_2_pressing_time")
  phase3PressingTime                             Float?    @map("phase_3_pressing_time")
  phase4PressingTime                             Float?    @map("phase_4_pressing_time")
  phase5PressingTime                             Float?    @map("phase_5_pressing_time")
  phase1AccelerationTime                         Float?    @map("phase_1_acceleration_time")
  phase2AccelerationTime                         Float?    @map("phase_2_acceleration_time")
  phase3AccelerationTime                         Float?    @map("phase_3_acceleration_time")
  phase4AccelerationTime                         Float?    @map("phase_4_acceleration_time")
  phase5AccelerationTime                         Float?    @map("phase_5_acceleration_time")
  phase1Pressure                                 Float?    @map("phase_1_pressure")
  phase2Pressure                                 Float?    @map("phase_2_pressure")
  phase3Pressure                                 Float?    @map("phase_3_pressure")
  phase4Pressure                                 Float?    @map("phase_4_pressure")
  phase5Pressure                                 Float?    @map("phase_5_pressure")
  cycleTimeSec                                   Float?    @map("cycle_time_sec")
  remarks                                        String?   @map("remarks")
  slabSummaryIds                                 String[]  @default([]) @map("slab_summary")
  automationLog                                  String?   @map("automation_log")
  batchWastageIds                                String[]  @default([]) @map("batch_wastage")
  productionReport                               String?   @map("production_report")
  importedAt                                     DateTime  @default(now()) @map("imported_at")
  syncedAt                                       DateTime  @updatedAt @map("synced_at")
  batchKey                                       String?   @map("batch_key")
  enteredById                                    String?   @map("entered_by_user_id") // who created this row in the ERP (operator self-edit)
  vacuumPumps                                    String?   @map("vacuum_pumps") // which pumps ran, e.g. "1,2,4" (count auto-fills noOfVacuumPumps)

  @@index([batchKey])
  // 0038 hot-path (2026-08-14): /live + /tables recency; date window (scoreStations, downtime,
  // dashboard press-today) was a 4.2 ms seq scan discarding 27,720 of 28,813 rows per call.
  @@index([importedAt])
  @@index([date])
  // 0051 hot-path (2026-08-23): pressPrefill (every /entry/mis load) and the hourly Telegram
  // press-vs-MIS check both window on created_time OR (created_time IS NULL AND imported_at);
  // with only imported_at indexed that was a 7 ms seq scan discarding all 30.5k rows per call.
  @@index([createdTime])
  @@map("press")
}

model Jot {
  id             String    @id @default(cuid())
  airtableId     String    @unique
  batch          String?   @map("batch")
  designName     String?   @map("design_name")
  operator       String?   @map("operator")
  slabNumber     Float?    @map("slab_number")
  date           DateTime? @map("date")
  createdTime    DateTime? @map("created_time")
  shift          String?   @map("shift")
  slabWeight     Float?    @map("slab_weight")
  thickness      String?   @map("thickness")
  thicknessAt1   Float?    @map("thickness_at_1")
  thicknessAt2   Float?    @map("thickness_at_2")
  thicknessAt3   Float?    @map("thickness_at_3")
  thicknessAt4   Float?    @map("thickness_at_4")
  thicknessAt5   Float?    @map("thickness_at_5")
  thicknessAt6   Float?    @map("thickness_at_6")
  thicknessAt7   Float?    @map("thickness_at_7")
  thicknessAt8   Float?    @map("thickness_at_8")
  bendMm         Float?    @map("bend_mm")
  slabDefect     String?   @map("slab_defect")
  defectPhoto    Json?     @map("defect_photo")
  remarks        String?   @map("remarks")
  slabSummaryIds String[]  @default([]) @map("slab_summary")
  importedAt     DateTime  @default(now()) @map("imported_at")
  syncedAt       DateTime  @updatedAt @map("synced_at")
  batchKey       String?   @map("batch_key")
  enteredById    String?   @map("entered_by_user_id") // who created this row in the ERP (operator self-edit)

  @@index([batchKey])
  // 0038 hot-path (2026-08-14): /tables recency; date window for scoreStations;
  // slab_number for avgThicknessFor's IN-list (was 1.9 ms seq scan discarding 17,759 rows).
  @@index([importedAt])
  @@index([date])
  @@index([slabNumber])
  @@map("jot")
}
